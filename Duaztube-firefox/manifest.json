{
    "manifest_version":  3,
    "name":  "DuazTube",
    "version":  "2.0.5",
    "description":  "Dual subtitles, synced music lyrics, instant word lookup, AI translation \u0026 speech-to-text for YouTube and Bilibili on Firefox.",
    "permissions":  [
                        "storage",
                        "activeTab"
                    ],
    "host_permissions":  [
                             "*://*.youtube.com/*",
                             "*://*.bilibili.com/*",
                             "*://*.hdslb.com/*",
                             "https://lrclib.net/*",
                             "https://translate.googleapis.com/*",
                             "https://clients5.google.com/*",
                             "https://www.bing.com/*",
                             "https://api.mymemory.translated.net/*",
                             "https://generativelanguage.googleapis.com/*",
                             "https://api.groq.com/*",
                             "https://openrouter.ai/*",
                             "https://api.deepseek.com/*",
                             "https://api.openai.com/*",
                             "http://localhost/*",
                             "http://127.0.0.1/*"
                         ],
    "icons":  {
                  "48":  "icon.svg",
                  "96":  "icon.svg"
              },
    "action":  {
                   "default_icon":  "icon.svg",
                   "default_popup":  "popup.html",
                   "default_title":  "DuazTube"
               },
    "options_ui":  {
                       "page":  "options.html",
                       "open_in_tab":  true
                   },
    "browser_specific_settings":  {
                                      "gecko":  {
                                                    "id":  "duaztube@local.dev",
                                                    "strict_min_version":  "140.0",
                                                    "data_collection_permissions":  {
                                                                                        "required":  [
                                                                                                         "none"
                                                                                                     ]
                                                                                    }
                                                },
                                      "gecko_android":  {
                                                            "strict_min_version":  "142.0"
                                                        }
                                  },
    "background":  {
                       "scripts":  [
                                       "background.js"
                                   ]
                   },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "*://*.youtube.com/*",
                                                "*://*.bilibili.com/*"
                                            ],
                                "js":  [
                                           "injected.js"
                                       ],
                                "run_at":  "document_start",
                                "world":  "MAIN"
                            },
                            {
                                "matches":  [
                                                "*://*.youtube.com/*",
                                                "*://*.bilibili.com/*"
                                            ],
                                "js":  [
                                           "content.js"
                                       ],
                                "css":  [
                                            "styles.css"
                                        ],
                                "run_at":  "document_start"
                            }
                        ]
}