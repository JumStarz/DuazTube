{
    "manifest_version":  3,
    "name":  "DuazTube",
    "version":  "2.0.5",
    "description":  "Dual subtitles, instant word lookup, AI translation \u0026 speech-to-text for YouTube and Bilibili.",
    "permissions":  [
                        "storage",
                        "activeTab"
                    ],
    "host_permissions":  [
                             "*://*.youtube.com/*",
                             "*://*.bilibili.com/*",
                             "*://*.hdslb.com/*",
                             "https://lrclib.net/*",
                             "https://translate.googleapis.com/*",
                             "https://clients5.google.com/*",
                             "https://www.bing.com/*",
                             "https://api.mymemory.translated.net/*",
                             "https://generativelanguage.googleapis.com/*",
                             "https://api.groq.com/*",
                             "https://openrouter.ai/*",
                             "https://api.deepseek.com/*",
                             "https://api.openai.com/*",
                             "http://localhost/*",
                             "http://127.0.0.1/*",
                             "https://api-lyrics.simpmusic.org/*",
                             "https://lyricsplus.prjktla.workers.dev/*",
                             "https://lyricsplus.atomix.one/*",
                             "https://lyricsplus-seven.vercel.app/*",
                             "https://lyrics.kugou.com/*"
                         ],
    "icons":  {
                  "16":  "icons/icon16.png",
                  "48":  "icons/icon48.png",
                  "128":  "icons/icon128.png"
              },
    "action":  {
                   "default_icon":  {
                                        "16":  "icons/icon16.png",
                                        "48":  "icons/icon48.png",
                                        "128":  "icons/icon128.png"
                                    },
                   "default_popup":  "popup.html",
                   "default_title":  "DuazTube"
               },
    "options_ui":  {
                       "page":  "options.html",
                       "open_in_tab":  true
                   },
    "background":  {
                       "service_worker":  "background.js"
                   },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "*://*.youtube.com/*",
                                                "*://*.bilibili.com/*"
                                            ],
                                "js":  [
                                           "injected.js"
                                       ],
                                "run_at":  "document_start",
                                "world":  "MAIN"
                            },
                            {
                                "matches":  [
                                                "*://*.youtube.com/*",
                                                "*://*.bilibili.com/*"
                                            ],
                                "js":  [
                                           "content.js"
                                       ],
                                "css":  [
                                            "styles.css"
                                        ],
                                "run_at":  "document_start"
                            }
                        ]
}